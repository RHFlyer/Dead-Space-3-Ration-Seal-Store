; ds3mod.h is a copy of the DS3 Mod Loader's SDK header from one loader release, the oldest this mod works with.
; Don't edit it: the build check (scripts/package-mod.ps1 -CheckOnly) compares it with the blob below. To move to a
; newer API, copy that loader release's sdk/ds3mod.h, change these four lines and min_loader= in mod.ini together.
loader=1.0.0
api=3
